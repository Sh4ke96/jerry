{
  "name": "jerry",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "JERRY — local development guardian for Claude Code (source repository).",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
