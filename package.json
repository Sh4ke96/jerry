    "@jerry/database": "workspace:*",
    "@jerry/platform": "workspace:*",
    "@jerry/policy-engine": "workspace:*",
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "kysely": "0.29.8",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
