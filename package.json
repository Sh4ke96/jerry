{
  "name": "jerry",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "JERRY — local development guardian for Claude Code (source repository).",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json && tsc -p apps/dashboard/tsconfig.json",
    "test": "vitest run",
    "check": "tsc -p tsconfig.json && tsc -p apps/dashboard/tsconfig.json && vitest run",
    "jerry": "node dist/cli/jerry.mjs",
    "spike:bench": "node scripts/bench-hook.mjs",
    "spike:live": "node scripts/e2e-live.mjs",
    "release": "node scripts/release.mjs",
    "desktop:dev": "corepack pnpm --filter @jerry/desktop dev",
    "desktop:build": "corepack pnpm --filter @jerry/desktop build",
    "desktop:test": "corepack pnpm --filter @jerry/desktop test"
  },
  "devDependencies": {
    "@jerry/contracts": "workspace:*",
    "@jerry/database": "workspace:*",
    "@jerry/discovery": "workspace:*",
    "@jerry/evals": "workspace:*",
    "@jerry/platform": "workspace:*",
    "@jerry/policy-engine": "workspace:*",
    "@jerry/quality": "workspace:*",
    "@jerry/skills": "workspace:*",
    "@jerry/trace-engine": "workspace:*",
    "@jerry/workflow": "workspace:*",
    "@types/node": "22.20.5",
    "@vitejs/plugin-vue-jsx": "5.1.6",
    "@vue/test-utils": "2.5.1",
    "esbuild": "0.28.2",
    "fastify": "5.12.8",
    "happy-dom": "21.0.4",
    "kysely": "0.29.8",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0",
    "vue": "3.5.45"
  }
}
