{
  "description": "JERRY guard: registers sessions, records and warns about edits outside a user-approved plan, and blocks only hard rules (Git state changes, .git writes, tampering with JERRY).",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/bridge.mjs", "session-start"],
            "timeout": 5,
            "onFailure": "continue"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash|PowerShell|Monitor",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/bridge.mjs", "pre-tool-use"],
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
